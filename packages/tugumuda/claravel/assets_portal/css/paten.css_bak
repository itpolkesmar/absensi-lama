.menu-tengah .navbar {
    margin-bottom: 0px;
    top: -22px;
}
.row.post {
    margin-left: -15px;
    margin-right: -15px;
    /*padding: 15px;*/
}
.breadcrumb {
    padding: 8px 15px;
    margin-bottom: 20px;
    margin-top: 15px;
    margin-left: 15px;
    margin-right: 15px;
    list-style: none;
    background-color: #55443C;
    border-radius: 0;
}
.breadcrumb a {
    color: #3DB5D1;
    text-decoration: none;
}
.breadcrumb a:hover, a:focus {
    color: #3DB5D1;
    text-decoration: underline;
}
.breadcrumb > .active {
    color: #C9A898;
}
.modul-box .modul-header .indeks a {
    color: #FFB55B;
}
.modul-box .modul-header .indeks a:hover {
    color: #FFF9ED;
    text-decoration: none;
}
body {
    font-family: 'Open Sans', helvetica, sans-serif;
    font-size: 14px;
    background-image: url(../images/pattern-epaten.jpg);
    line-height: 1.42857143;
    color: #fff9ed;
    background-color: #3F3029;
}
.runtext {
    background-color: #AD2D2D;
    margin-top: -17px;
}
.navbar-default {
    background-color: #3F3029;
    border-color: #3F3029;
}
.navbar-default .navbar-nav > li > a {
    color: #ffffff;
    font-size: 16px;
    font-family: 'Quicksand', sans-serif;
    font-weight: 400;
    letter-spacing: 0px;
}
.navbar-default .navbar-nav > .active > a, .navbar-default .navbar-nav > .active > a:hover, .navbar-default .navbar-nav > .active > a:focus {
    color: #3db5d1;
    background-color: #55443C;
}
.navbar-default .navbar-nav > li > a:hover, .navbar-default .navbar-nav > li > a:focus {
    color: #3db5d1;
    background-color: transparent;
}
.navbar-default .navbar-nav > .dropdown > a .caret.white {
    border-top-color: white;
    border-bottom-color: white;
}
.navbar-default .navbar-nav > .dropdown > a:hover .caret.white {
    border-top-color: #3db5d1;
    border-bottom-color: #3db5d1;
}
.navbar-default .navbar-nav > .dropdown > a:focus .caret.white {
    border-top-color: #3db5d1;
    border-bottom-color: #3db5d1;
}
.navbar-default .navbar-nav > .open > a, .navbar-default .navbar-nav > .open > a:hover, .navbar-default .navbar-nav > .open > a:focus {
    background-color: #55443C;
    color: #3db5d1;
}
.bodycoklat {
    background-color: #3F3029;
}
.garis {
    border-bottom: 3px solid #FFF9ED;
}
.modul-box .modul-header .teks {
    background-color: #FFF9ED;
    color: #3F3029;
    font-weight: bold;
    display: inline-block;
    vertical-align: top;
    zoom: 1;
    padding: 3px 10px;
}
.modul-box .modul-header {
    color: #FFF9ED;
    font-size: 20px;
    line-height: 1.11em;
    margin: 0 0 20px 0px;
    padding: 0 15px;
    text-transform: uppercase;
    position: relative;
    overflow: hidden;
}
.pagination a {
    color: #3F3029;
    text-decoration: none;
}
.list.berita p {
    color: #FFF9ED;
}
.list.berita li a h3 {
    color: #3db5d1;
    font-family: "Quicksand", helvetica, sans-serif;
    font-weight: 600;
}
.berita a:hover {
    color: #3db5d1;
}
.list.pengumuman p {
    color: #FFF9ED;
}
.list.pengumuman li a h3 {
    color: #3db5d1;
    font-family: "Quicksand", helvetica, sans-serif;
    font-weight: 600;
}
.pengumuman a:hover {
    color: #3db5d1;
}
.list li .meta {
    color: #FFB55B;
}
#headline {
    background-color: #765242;
    margin: 0;
    margin-bottom: 20px;
    position: relative;
    z-index: 0;
}
.flex-control-nav li {
    margin: 0;
    display: inline-block;
    zoom: 1;
    border: 1px solid #3DB5D1;
    color: #3DB5D1;
    padding: 5px 11px;
    border-radius: 50px;
    -webkit-transition: all .25s ease;
    -moz-transition: all .25s ease;
    -ms-transition: all .25s ease;
    -o-transition: all .25s ease;
    transition: all .25s ease;
}
.flex-control-nav li:hover {
    background-color: #3DB5D1;
    border-color: #3DB5D1;
    color: #3F3029;
    cursor: pointer;
}


.panel-default > .panel-heading {
    color: #FFFFFF;
    background-color: #3DB5D1;
    border-color: #dddddd;
}
.list-group-item {
    position: relative;
    display: block;
    padding: 8px 15px;
    margin-bottom: -1px;
    background-color: #FFF9ED;
    border: 1px solid #55443C;
}
.list.pengumuman li a:hover h3 {
    color: #87E9FF;
}
.list.berita li a:hover h3 {
    color: #87E9FF;
}
a.list-group-item:hover, a.list-group-item:focus {
    text-decoration: none;
    background-color: #F5EBD7;
}
a.list-group-item {
    color: #3DB5D1;
}
.isi {
    padding: 15px;
}
.isi h1, h2, h3, h4, h5 {
    font-family: "Quicksand", helvetica, sans-serif;
    font-weight: 600;
}
.isi p {
    font-family: 'Open Sans', helvetica, sans-serif;
}
.modul-box {
    margin-top: 20px;
    margin-bottom: 30px;
    padding: 15px;
}
.artikel .meta {
    color: #F1AB57;
}
a:hover, a:focus {
    color: #3DB5D1;
    text-decoration: underline;
}
.artikel {
    margin-left: 15px;
}
.artikel .judul-artikel {
    font-family: "Quicksand", helvetica, sans-serif;
    font-weight: 600;
}
.list.media li a h5 {
    color: #3DB5D1;
}
.list.media li a:hover h5 {
    color: #87E9FF;
}
.list li a {
    color: #3DB5D1;
    display: block;
    padding: 0;
}
.list li a:hover {
    color: #F1AB57;
    text-decoration: none;
}
.galeri li:hover {
    -webkit-box-shadow: 0 0 0 1px #555, 0 0 0 2px #3DB5D1;
    box-shadow: 0 0 0 1px #555, 0 0 0 2px #3DB5D1;
}







#content {
    /* padding: 15px; */
    margin-left: 15px;
    margin-right: 15px;
}
#content thead {
    background-color: #F1AB57;
    color: #3F3029;
}
/*#content tbody {
    background-color: #55443C;
    color: #FFF9ED;
}*/
.warnabodytabel tbody {
    background-color: #55443C;
}
.btn-default {
    color: #3F3029;
    background-color: #3DB5D1;
    border-color: #55443C;
}
.btn-default:hover, .btn-default:focus, .btn-default:active, .btn-default.active, .open .dropdown-toggle.btn-default {
    color: #3F3029;
    background-color: #87E9FF;
    border-color: #55443C;
}
#content .list li {
    border-bottom: none; 
    margin-bottom: 20px;
}
.diagram {
    padding: 5px;
    border: solid 1px;
    display: table;
    height: 50px;
    width: 100px;
    text-align: center;
    position: absolute;
}
.diagram-parent {
    position: relative;
    display: block;
}
.alur-title {
    text-align: center;
    background: #FFF9ED;
    color: #3F3029;
    font-weight: bolder;
    font-size: 20px;
}
.oval {
    border-radius: 3%;
}
.arrow {
    background: url(../images/arrow.png) no-repeat;
    background-size: 100% 100%;
    min-height: 40px;
    width: 60px;
    position: absolute;
}
.down {
    transform: rotate(90deg);
    -ms-transform: rotate(90deg);
    -webkit-transform: rotate(90deg);
}
.left {
    -moz-transform: scaleX(-1);
    -o-transform: scaleX(-1);
    -webkit-transform: scaleX(-1);
    transform: scaleX(-1);
    filter: FlipH;
    -ms-filter: "FlipH";
}
.up {
    transform: rotate(270deg);
    -ms-transform: rotate(270deg);
    -webkit-transform: rotate(270deg);
}


















/*footer*/
.copyright {
    background-color: #3DB5D1;
    -webkit-box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
    margin-top: 30px;
    padding: 20px 0;
    text-align: center;
}
.copyright p {
    color: #3F3029;
    margin: 0;
}
.copyright p a {
    color: #FFF9ED;
}
/*footer*/


::selection {
    background-color: #3DB5D1;
    color: white;
}






