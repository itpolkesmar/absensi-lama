

header {
    margin: 0;
    margin-bottom: 91px;
    padding: 0;
    height: 118px;
    padding-top: 0px;
    background-color: white;
    background-image: url(../images/header.jpg);
    background-repeat: no-repeat;
    background-position: center;
    background-size: cover;
    z-index: 1;
}
#logo h1 {
    float: left;
    margin-left: 0px;
    margin-top: 0px;
    margin-bottom: 0px;
    color: #3f3029;
    font-family: 'Exo 2', sans-serif;
    font-size: 37px;
    font-weight: 700;
}
#logo h4 {
    margin-left: 0px;
    margin-top: 25px;
    color: #3f3029;
    font-family: 'Exo 2', sans-serif;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
}
h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, .h5, .h6 {
    font-family: "Quicksand", Helvetica, Arial, sans-serif;
    font-weight: 600;
    line-height: 1.1;
    text-rendering: optimizeLegibility;
}
